# Type stub for `Falkon`, the module PyFalkon injects into Falkon's embedded
# Python (no PyPI package). Covers the API this plugin and its test probe use,
# typed against the PySide6 classes the Falkon types derive from
# (src/plugins/PyFalkon/typesystem_pyfalkon.xml, src/lib/**/*.h, Falkon 26.04).

import enum
import typing

from PySide6.QtCore import QByteArray, QObject, QPoint, QSettings, QSize, QUrl, Signal
from PySide6.QtGui import QIcon
from PySide6.QtWebEngineCore import QWebEnginePage, QWebEngineProfile
from PySide6.QtWebEngineWidgets import QWebEngineView
from PySide6.QtWidgets import QApplication, QMainWindow, QMenu, QWidget
from shiboken6.Shiboken import Object as _Wrapper  # base of every PyFalkon type

def registerPlugin(plugin: PluginInterface) -> None: ...

class PluginInterface(_Wrapper):
    class InitState(enum.IntEnum):
        StartupInitState = 0
        LateInitState = 1

    StartupInitState: typing.ClassVar[PluginInterface.InitState]
    LateInitState: typing.ClassVar[PluginInterface.InitState]

    def init(self, state: PluginInterface.InitState, settingsPath: str) -> None: ...
    def unload(self) -> None: ...
    def testPlugin(self) -> bool: ...
    def showSettings(self, parent: QWidget | None = ...) -> None: ...
    def populateWebViewMenu(self, menu: QMenu, view: WebView, r: WebHitTestResult) -> None: ...

class PasswordEntry(_Wrapper):
    id: typing.Any          # QVariant: whatever the backend stored
    host: str
    username: str
    password: str
    data: QByteArray
    updated: int
    def __init__(self) -> None: ...

class PageFormData(_Wrapper):
    username: str
    password: str
    postData: QByteArray
    def __init__(self) -> None: ...

class PasswordBackend(_Wrapper):
    def __init__(self) -> None: ...
    def name(self) -> str: ...
    def getUsernames(self, url: QUrl) -> list[str]: ...
    def getEntries(self, url: QUrl) -> list[PasswordEntry]: ...
    def getAllEntries(self) -> list[PasswordEntry]: ...
    def addEntry(self, entry: PasswordEntry) -> None: ...
    def updateEntry(self, entry: PasswordEntry) -> bool: ...
    def updateLastUsed(self, entry: PasswordEntry) -> None: ...
    def removeEntry(self, entry: PasswordEntry) -> None: ...
    def removeAll(self) -> None: ...
    def setActive(self, active: bool) -> None: ...
    def isActive(self) -> bool: ...
    def hasSettings(self) -> bool: ...
    def showSettings(self, parent: QWidget | None) -> None: ...

class PasswordManager(QObject):
    def getUsernames(self, url: QUrl) -> list[str]: ...
    def getEntries(self, url: QUrl) -> list[PasswordEntry]: ...
    def availableBackends(self) -> dict[str, PasswordBackend]: ...
    def activeBackend(self) -> PasswordBackend: ...
    def switchBackend(self, backendID: str) -> None: ...
    def registerBackend(self, id: str, backend: PasswordBackend) -> bool: ...
    def unregisterBackend(self, backend: PasswordBackend) -> None: ...

class AutoFill(QObject):
    def passwordManager(self) -> PasswordManager: ...
    def getFormData(self, url: QUrl) -> list[PasswordEntry]: ...
    @typing.overload
    def addEntry(self, url: QUrl, formData: PageFormData) -> None: ...
    @typing.overload
    def addEntry(self, url: QUrl, name: str, password: str) -> None: ...
    @typing.overload
    def updateEntry(self, entry: PasswordEntry) -> bool: ...
    @typing.overload
    def updateEntry(self, url: QUrl, name: str, password: str) -> None: ...

class ExternalJsObject(QObject):
    @staticmethod
    def registerExtraObject(id: str, object: QObject) -> None: ...
    @staticmethod
    def unregisterExtraObject(object: QObject) -> None: ...

class Settings(_Wrapper):
    @staticmethod
    def globalSettings() -> QSettings: ...

class DesktopNotificationsFactory(QObject):
    def showNotification(self, heading: str, text: str) -> None: ...

class WebPage(QWebEnginePage): ...

class WebView(QWebEngineView):
    def page(self) -> WebPage: ...

class TabbedWebView(WebView): ...

class WebHitTestResult(_Wrapper):
    def isContentEditable(self) -> bool: ...
    def tagName(self) -> str: ...
    def baseUrl(self) -> QUrl: ...

class AbstractButtonInterface(QObject):
    class ClickController:
        def callPopupPosition(self, size: QSize) -> QPoint: ...
        def callPopupClosed(self) -> None: ...

    clicked: typing.ClassVar[Signal]
    webViewChanged: typing.ClassVar[Signal]
    def __init__(self, parent: QObject | None = ...) -> None: ...
    def id(self) -> str: ...
    def name(self) -> str: ...
    def setIcon(self, icon: QIcon) -> None: ...
    def setTitle(self, text: str) -> None: ...
    def toolTip(self) -> str: ...
    def setToolTip(self, toolTip: str) -> None: ...
    def badgeText(self) -> str: ...
    def setBadgeText(self, badgeText: str) -> None: ...
    def webView(self) -> WebView | None: ...

class NavigationBar(QWidget):
    def addToolButton(self, button: AbstractButtonInterface) -> None: ...
    def removeToolButton(self, button: AbstractButtonInterface) -> None: ...

class BrowserWindow(QMainWindow):
    def navigationBar(self) -> NavigationBar: ...
    def weView(self) -> TabbedWebView | None: ...

class PluginProxy(QObject):
    mainWindowCreated: typing.ClassVar[Signal]
    mainWindowDeleted: typing.ClassVar[Signal]
    webPageCreated: typing.ClassVar[Signal]
    webPageDeleted: typing.ClassVar[Signal]

class MainApplication(QApplication):
    # Always set while a plugin runs.
    @staticmethod
    def instance() -> MainApplication: ...
    def autoFill(self) -> AutoFill: ...
    def webProfile(self) -> QWebEngineProfile: ...
    def plugins(self) -> PluginProxy: ...
    def windows(self) -> list[BrowserWindow]: ...
    def getWindow(self) -> BrowserWindow | None: ...
    def desktopNotifications(self) -> DesktopNotificationsFactory: ...
